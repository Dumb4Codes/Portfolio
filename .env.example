# Copy to .env.local for local work. Real values live in Vercel > Settings > Environment Variables.

# Public site address, used for canonical URLs, sitemap and share images. Include https://
NEXT_PUBLIC_SITE_URL=https://youvraj-singh.vercel.app

# Admin (Keystatic) in production: the GitHub repo it commits to
NEXT_PUBLIC_GITHUB_OWNER=Dumb4Codes
NEXT_PUBLIC_GITHUB_REPO=Portfolio

# Written by Keystatic when you create the GitHub App (see docs/SETUP_GUIDE.md, step 3)
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Contact form. Free key from web3forms.com (public by design). Empty = form hidden, email button stays.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Force the admin storage: "local" = files on this computer, "github" = commit to the repo.
# Normally unset (local in dev, github in production). Needed at BUILD time.
# NEXT_PUBLIC_KEYSTATIC_STORAGE=local
